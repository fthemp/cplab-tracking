nodered/.node-red/
nodered/*_cred.json
nodered/.config.*.json

# ===== Mosquitto runtime =====
mosquitto/*.db
mosquitto/passwd

# ===== Python (simulator) =====
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

